{
  "name": "notion-import",
  "version": "0.1.1",
  "private": true,
  "description": "Obsidian plugin that matches notes to Notion pages and imports selected Notion content.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theshayneb/notion-import.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "lint": "eslint .",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian-plugin"],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "1.13.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1"
  }
}
